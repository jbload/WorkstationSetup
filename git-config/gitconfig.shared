# To preserve machine-managed ~/.gitconfig entries, include this file from ~/.gitconfig:
# [include]
# 	path = ~/src/Three21/WorkstationSetup/git-config/gitconfig.shared
#
# Include gitconfig.macos, gitconfig.linux, or gitconfig.windows next, then ~/.gitconfig.local-machine.

[advice]
	skippedCherryPicks = false
[alias]
	aa = add -A
	aamend = "!f() { git aa && git amend; }; f"
	aamendit = "!f() { git aa && git amendit; }; f"
	ac = "!f() { git aa && git cm \"$@\"; }; f"
	adc = !git add -A && git duet-commit -m
	aliases = "!f() { VERBOSE=false; case \"$1\" in -v|--verbose) VERBOSE=true; shift ;; esac; FILTER=\"$1\"; git config --get-regexp '^alias\\.' | sed 's/^alias\\.//' | while IFS=' ' read -r NAME COMMAND; do DESCRIPTION=$(git config --get \"alias-help.$NAME\" 2>/dev/null || :); case \"$NAME $COMMAND $DESCRIPTION\" in *\"$FILTER\"*) if $VERBOSE; then printf '%-12s %-48s %s\\n' \"$NAME\" \"$COMMAND\" \"${DESCRIPTION:-No description}\"; else printf '%-12s %s\\n' \"$NAME\" \"${DESCRIPTION:-No description}\"; fi ;; esac; done; }; f"
	amend = commit --amend
	amendit = commit --amend --no-edit
	bclean = "!f() { DEFAULT=$(git default); git branch --merged ${1-$DEFAULT} | grep -v " ${1-$DEFAULT}$" | xargs git branch -d; }; f"
	bdone = "!f() { DEFAULT=$(git default); git checkout ${1-$DEFAULT} && git up && git bclean ${1-$DEFAULT}; }; f"
	br = branch
	branches = branch -a
	churn = !git --no-pager log --name-only --oneline | grep -v ' ' | sort | uniq -c | sort -nr | head
	cm = commit -m
	co = checkout
	cob = "!f() { test -n \"$1\" || { echo \"Usage: git cob <name>\"; exit 1; }; git checkout -b $USER/$1; }; f"
	cod = "!f() { DEFAULT=$(git default); git checkout ${1-$DEFAULT}; }; f"
	conflicts = !git diff --name-only --diff-filter=U
	contrib = shortlog -e --summary --numbered
	cowt = "!f() { test -n \"$1\" || { echo \"Usage: git cowt <name>\"; exit 1; }; WTDIR=$(git wtpath \"$1\") && git worktree add -b $USER/$1 \"$WTDIR\" && echo \"$WTDIR\"; }; f"
	cp = cherry-pick
	current = branch --show-current
	dci = duet-commit
	default = !git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'
	di = diff
	dih = diff HEAD
	dis = diff --staged
	dist = diff --stat
	disth = diff HEAD --stat
	dists = diff --staged --stat
	dmg = duet-merge
	drb = rebase -i --exec 'git duet-commit --amend'
	drv = duet-revert
	dt = difftool
	dtd = difftool --dir-diff
	dth = difftool HEAD
	dts = difftool --staged
	ec = config --global -e
	fixup = commit --fixup
	ftdone = "!f() { DEFAULT=$(git default); FEATURE=$(git rev-parse --abbrev-ref HEAD); if OUTPUT=$(git status --porcelain | wc -l) && [ $OUTPUT -eq 0 ]; then git checkout -q ${1-$DEFAULT}; echo "On $DEFAULT branch. Pulling changes from remote."; git pull --rebase; echo "Merging changes from branch: $FEATURE"; git merge --squash $FEATURE; echo "Ready to commit."; else echo "Git repo is dirty."; fi }; f"
	ftstart = "!f() { git start \"$@\"; }; f"
	hist = log --graph --abbrev-commit --decorate --date=relative --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	isclean = "!f() { test -z \"$(git status --porcelain)\" || { echo \"Git repo is dirty.\"; exit 1; }; }; f"
	last = log -1 --oneline
	lds = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
	lg = log --graph --decorate --oneline --all
	ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
	migrate = "!f() { DEFAULT=$(git default); CURRENT=$(git symbolic-ref --short HEAD); git checkout -b $1 && git branch --force $CURRENT ${3-$CURRENT@{u}} && git rebase --onto ${2-$DEFAULT} $CURRENT; }; f" # Moves a set of commits from the current branch to another
	msq = merge --squash
	precommit = "!f() { git isclean && git fetch --prune origin && git rebase origin/$(git default) && git status --short --branch; }; f"
	prl = "!f() { git fetch origin --prune --prune-tags && git worktree prune && git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | while read -r branch track; do test \"$track\" = \"[gone]\" && git branch -d \"$branch\"; done; }; f"
	pushf = pushup --force-with-lease
	pushup = !git push -u origin HEAD
	rb = "!f() { git isclean && git rebase ${1-origin/$(git default)}; }; f"
	rbd = "!f() { git isclean && git fetch --prune origin && git rebase origin/$(git default); }; f"
	rba = rebase --abort
	rbc = !git add -A && git rebase --continue
	rbi = rebase --interactive
	rbo = "!f() { git isclean && git rebase --onto ${2-origin/$(git default)} \"$1\"; }; f" # Replay <fork-point>..HEAD onto a new base (default origin/master); use when your branch sits on feature branches that got squash-merged
	reauthor = commit --amend --reset-author --no-edit
	remotes = remote -v
	reword = commit --amend
	rhh = reset HEAD --hard
	root = rev-parse --show-toplevel
	save = !git add -A && git commit -m 'SAVEPOINT'
	squash = commit --squash
	st = status
	sta = stash
	start = "!f() { test -n \"$1\" || { echo \"Usage: git start <branch-name>\"; exit 1; }; git isclean && git fetch --prune origin && BASE=$(git rev-parse --verify origin/$(git default)) && git checkout -b $USER/$1 $BASE; }; f"
	stashes = stash list
	stb = status --short --branch
	sync = !git pull --rebase && git push
	undo = reset HEAD~1 --mixed
	unstage = restore --staged
	up = !git pull --rebase --prune && git submodule update --init --recursive
	wip = !git add -u && git commit -m "WIP"
	wipe = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard
	wt = worktree
	wtls = worktree list
	wtpath = "!f() { test -n \"$1\" || { echo \"Usage: git wtpath <name>\"; exit 1; }; echo \"${WORKSPACE:-$HOME}/.worktrees/$(basename $(git rev-parse --show-toplevel))/$1\"; }; f"
	wtprune = worktree prune
	wtstart = "!f() { test -n \"$1\" || { echo \"Usage: git wtstart <name>\"; exit 1; }; git fetch --prune origin && WTDIR=$(git wtpath \"$1\") && BASE=$(git rev-parse --verify origin/$(git default)) && git worktree add -b $USER/$1 \"$WTDIR\" $BASE && echo \"$WTDIR\"; }; f"
[alias-help]
	aa = Alias for 'git add -A' - stage all changes
	aamend = Stage all changes and amend the previous commit
	aamendit = Stage all changes and amend without editing the message
	ac = Stage all changes and commit with a message
	adc = Stage all changes and create a duet commit
	aliases = List aliases and descriptions - use --verbose to include commands
	amend = Alias for 'git commit --amend' - amend the previous commit
	amendit = Alias for 'git commit --amend --no-edit' - amend without editing the message
	bclean = Delete local branches already merged into the default branch
	bdone = Switch to the default branch, pull, and delete merged branches
	br = Alias for 'git branch' - list or manage branches
	branches = Alias for 'git branch -a' - list all local and remote branches
	churn = Show the most frequently changed files in history
	cm = Alias for 'git commit -m' - create a commit with a message
	co = Alias for 'git checkout' - check out a branch
	cob = Create a user-namespaced branch
	cod = Check out the specified or default branch
	conflicts = List files with unresolved merge conflicts
	contrib = Show contributors ranked by commit count
	cowt = Create a user-namespaced worktree branch
	cp = Alias for 'git cherry-pick' - cherry-pick commits
	current = Alias for 'git branch --show-current' - show the current branch name
	dci = Create a duet commit
	default = Show the default remote branch
	di = Alias for 'git diff' - show unstaged changes
	dih = Alias for 'git diff HEAD' - show changes from HEAD
	dis = Alias for 'git diff --staged' - show staged changes
	dist = Alias for 'git diff --stat' - show unstaged diff statistics
	disth = Alias for 'git diff HEAD --stat' - show diff statistics from HEAD
	dists = Alias for 'git diff --staged --stat' - show staged diff statistics
	dmg = Create a duet merge
	drb = Rebase interactively with duet commit amendments
	drv = Revert with a duet commit
	dt = Alias for 'git difftool' - open the configured diff tool
	dtd = Alias for 'git difftool --dir-diff' - open the configured diff tool in directory mode
	dth = Alias for 'git difftool HEAD' - compare HEAD using the configured diff tool
	dts = Alias for 'git difftool --staged' - compare staged changes using the configured diff tool
	ec = Alias for 'git config --global -e' - edit the global Git configuration
	fixup = Alias for 'git commit --fixup' - create a fixup commit
	ftdone = Squash a feature branch into the default branch
	ftstart = Start a feature branch
	hist = Show graph history with relative dates and decorations
	isclean = Verify that the working tree is clean
	last = Alias for 'git log -1 --oneline' - show the latest commit
	lds = Alias for formatted git log - show compact decorated history with dates
	lg = Alias for 'git log --graph --decorate --oneline --all' - show compact graph history across all branches
	ls = Alias for formatted git log - show compact decorated history
	migrate = Move commits from the current branch onto another base
	msq = Alias for 'git merge --squash' - merge commits without creating a merge commit
	precommit = Fetch, rebase onto the default branch, and show status
	prl = Prune stale worktree metadata and remove local branches whose remote tracking branches are gone
	pushf = Force-push with lease protection
	pushup = Push the current branch and set its upstream
	rb = Rebase onto the specified or default branch
	rbd = Fetch and rebase onto the default branch
	rba = Alias for 'git rebase --abort' - abort the current rebase
	rbc = Stage changes and continue the current rebase
	rbi = Alias for 'git rebase --interactive' - start an interactive rebase
	rbo = Replay commits onto a new base
	reauthor = Amend the previous commit with a new author
	remotes = Alias for 'git remote -v' - list remote URLs
	reword = Alias for 'git commit --amend' - amend the previous commit message
	rhh = Alias for 'git reset HEAD --hard' - hard-reset HEAD and discard working-tree changes
	root = Alias for 'git rev-parse --show-toplevel' - show the repository root directory
	save = Alias for 'git add -A' and 'git commit' - create a SAVEPOINT commit containing all changes
	squash = Alias for 'git commit --squash' - create a squash commit
	st = Alias for 'git status' - show working-tree status
	sta = Alias for 'git stash' - stash changes
	start = Create a clean feature branch from the default remote branch
	stashes = Alias for 'git stash list' - list stashes
	stb = Alias for 'git status --short --branch' - show short branch-aware status
	sync = Pull with rebase, then push
	undo = Alias for 'git reset HEAD~1 --mixed' - undo the previous commit while keeping its changes
	unstage = Alias for 'git restore --staged' - remove files from the staging area
	up = Pull with rebase and prune, then update submodules
	wip = Commit tracked changes as WIP
	wipe = Save all changes, then reset the savepoint commit
	wt = Alias for 'git worktree' - list or manage worktrees
	wtls = Alias for 'git worktree list' - list worktrees
	wtpath = Show the path for a named worktree
	wtprune = Alias for 'git worktree prune' - prune stale worktree metadata
	wtstart = Create a worktree from the default remote branch
[branch]
	autosetuprebase = always
	sort = -committerdate
[column]
    	ui = auto
[core]
	editor = code --wait
	hooksPath = ~/git-hooks
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
	tool = bc
[difftool]
	prompt = false
[fetch]
	all = true
	prune = true
[help]
	autocorrect = prompt
[http]
	postBuffer = 524288000
[init]
	defaultBranch = master
	templateDir = ~/git-templates
[merge]
	tool = bc
[mergetool]
	keepBackup = false
	prompt = false
[mergetool "bc"]
	trustExitCode = true    
[pull]
	rebase = true    
[push]
	autoSetupRemote = true
	default = simple
	followTags = true
[rebase]
	autoSquash = true
	autoStash = true
	updateRefs = true
[rerere]
	autoupdate = true
	enabled = true
[tag]
	sort = version:refname
[trailer]
	ifexists = addIfDifferent	
[transfer]
	fsckobjects = true	
[user]
	email = jbload@users.noreply.github.com
	name = Justin Loadholtz
